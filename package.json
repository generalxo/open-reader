{
  "name": "open-reader",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/electron/main.js",
  "author": "Oliver Wasner",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "npm-run-all --parallel dev:react dev:electron",
    "dev:react": "vite",
    "dev:electron": "npm run transpile:electron && wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron .",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "transpile:electron": "tsc -p src/electron/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "test": "vitest",
    "test:run": "vitest run",
    "dist:mac": "npm run transpile:electron && electron-builder --mac --arm64",
    "dist:win": "npm run transpile:electron && electron-builder --win --x64",
    "dist:linux": "npm run transpile:electron && electron-builder --linux --x64"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-router": "^1.168.8",
    "@tanstack/react-router-devtools": "^1.166.11",
    "adm-zip": "^0.5.16",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.5.9",
    "lucide-react": "^1.3.0",
    "motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tanstack/router-plugin": "^1.167.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^41.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.2",
    "wait-on": "^9.0.4"
  },
  "build": {
    "win": {
      "icon": "desktopIcon.png"
    },
    "linux": {
      "icon": "desktopIcon.png"
    },
    "extraResources": [
      {
        "from": "src/electron/db/migrations",
        "to": "migrations"
      }
    ]
  }
}
